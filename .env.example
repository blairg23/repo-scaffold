# Copy to .env and set real values.
# Keep .env uncommitted.

# GitHub token used by repo creation/settings/backlog scripts.
# Recommended classic PAT scopes: repo, workflow, read:org.
# Optional scopes: delete_repo (auto-cleanup), project (if you automate Projects).
GH_TOKEN=ghp_replace_with_real_token

# Optional metadata for local docs/tooling.
GITHUB_ORG=YOUR_ORG
GITHUB_REPO=YOUR_REPO
# Alternative single value:
# GH_REPO=YOUR_ORG/YOUR_REPO

# Legacy lowercase aliases are still supported:
# github_token=...
# github_org=...
# github_repo=...
# github_full_repo=...
